  "designation_schemas": [
    {
      "manufacturer": "MARSHAL",
      "query_regex": "11[сc]67[пp](?:\\s+GAS\\s+PRO)?\\s+(?P<model>(?P<family>[0-9]?[А-Яа-яЁё]+)\\.(?P<material>0[01])\\.(?P<execution>[^.\\s]+)\\.(?P<pn>\\d{3})\\.(?P<dn>\\d{2,4})(?:/\\d{2,4})?)",
      "identity_group": "model",
      "fixed_facts": {
        "product_type": "ball_valve",
        "body_material": "steel"
      },
      "field_extractors": {
        "dn": {
          "group": "dn",
          "type": "int"
        },
        "pn_min_mpa": {
          "group": "pn",
          "type": "float_div",
          "divisor": 10
        },
        "body_material_grade": {
          "group": "material",
          "map": {
            "00": "20",
            "01": "09Г2С"
          }
        },
        "control": {
          "group": "execution",
          "map": {
            "1": "manual",
            "3": "gearbox"
          },
          "default": null
        },
        "joining_type": {
          "group": "family",
          "regex_map": [
            {
              "regex": "(?:ФП|ПФ)",
              "value": null
            },
            {
              "regex": "Ф$",
              "value": "flanged"
            },
            {
              "regex": "ЦР",
              "value": "threaded"
            },
            {
              "regex": "П$",
              "value": "welded"
            }
          ],
          "default": null
        },
        "bore_type": {
          "group": "family",
          "regex_map": [
            {
              "regex": "^(?:2ЦП|2ЦФ)$",
              "value": "reduced"
            },
            {
              "regex": "^(?:ЦП|ЦФ|3ЦП)$",
              "value": "full"
            }
          ],
          "default": null
        }
      },
      "query_fact_rules": [
        {
          "regex": "\\bGAS\\s+PRO\\b",
          "facts": {
            "working_medium": "газ",
            "valve_type": "gas"
          }
        }
      ],
      "source": {
        "url": "https://lztamarshal.ru/upload/2023-catalogue/2025%20Marshal_Catalogue.pdf",
        "source_type": "official_catalog_pdf",
        "identity_level": "FAMILY_LEVEL",
        "evidence_scope": "nomenclature_schema",
        "evidence_text": "Official MARSHAL catalog documents 11с67п designation families including ЦП/2ЦП and 2ЦФ, material executions 00/01, DN/PN tables and control executions."
      }
    },
    {
      "manufacturer": "ALSO",
      "query_regex": "(?P<model>КШ[.\\s-]*(?P<body>[A-ZА-ЯЁ0-9.]+?)[.\\s-]+(?P<dn>\\d{2,3})[.\\s-]+(?P<pn>\\d{2})[.\\-–—](?P<variant>\\d{2}))",
      "identity_group": "model",
      "fixed_facts": {
        "product_type": "ball_valve",
        "body_material": "steel"
      },
      "field_extractors": {
        "dn": {
          "group": "dn",
          "type": "int"
        },
        "pn_min_mpa": {
          "group": "pn",
          "type": "float_div",
          "divisor": 10
        },
        "body_material_grade": {
          "group": "variant",
          "map": {
            "01": "20",
            "02": "09Г2С",
            "03": "12Х18Н10Т"
          }
        },
        "joining_type": {
          "group": "body",
          "regex_map": [
            {
              "regex": "^МФ",
              "value": "wafer"
            },
            {
              "regex": "^Ф",
              "value": "flanged"
            },
            {
              "regex": "^П",
              "value": "welded"
            },
            {
              "regex": "^[МР]",
              "value": "threaded"
            }
          ],
          "default": null
        },
        "bore_type": {
          "group": "body",
          "regex_map": [
            {
              "regex": "^Ф.*З",
              "value": null
            },
            {
              "regex": "^(?:ФП|ПП)(?:\\.|$)",
              "value": "full"
            },
            {
              "regex": ".*",
              "value": "reduced"
            }
          ],
          "default": null
        }
      },
      "query_fact_rules": [
        {
          "regex": "(?:^|[.\\s])GAS(?:[.\\s]|$)",
          "facts": {
            "working_medium": "газ",
            "valve_type": "gas"
          }
        }
      ],
      "source": {
        "url": "https://alsoarm.ru/series/gas-series/",
        "source_type": "official_series_page",
        "identity_level": "FAMILY_LEVEL",
        "evidence_scope": "nomenclature_schema",
        "evidence_text": "Official ALSO series pages publish the ball-valve designation structure; connection prefix П denotes welded connection and must not itself be treated as a full-bore marker. Full bore is inferred only from explicit full-bore body codes."
      }
    }
  ]
